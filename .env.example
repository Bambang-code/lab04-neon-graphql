# Next.js otomatis baca file .env.local untuk development lokal
# (BUKAN .env biasa). Copy file ini jadi .env.local lalu isi:
#
#   cp .env.example .env.local
#
# Ambil connection string dari dashboard Neon (Connect > Postgres database),
# dan PASTIKAN toggle "Connection pooling" dalam keadaan NYALA (hostname-nya
# harus ada akhiran -pooler) — beda dengan versi yang dipakai untuk Render.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.neon.tech/dbname?sslmode=require
